# Optional — enables LLM agent loop for complex instructions.
# Without a key, TabHandoff uses the deterministic DOM extractor (public pages).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional override for receipt/job store (default: ~/.tabhandoff)
# TABHANDOFF_HOME=
