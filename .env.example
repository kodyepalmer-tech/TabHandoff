# AI providers (pick one). Keys stay in process env / local settings only —
# never written into ZIP packages, extension storage, or bridge logs.
#
# Free / local (preferred for demos — no paid credits):
#   1) Install Ollama, pull a model, leave it running
#   2) Either set TABHANDOFF_AI_PROVIDER=ollama  OR just leave Ollama on :11434
#      (bridge auto-detects a live local Ollama daemon)
# TABHANDOFF_AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#
# OpenAI-compatible cloud:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Groq (OpenAI-compatible, often has a free tier — founder-owned key):
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
#
# Anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional override for receipt/job/AI-task store (default: ~/.tabhandoff)
# TABHANDOFF_HOME=
