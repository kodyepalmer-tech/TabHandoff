{
  "name": "@tabhandoff/mcp",
  "version": "0.1.0",
  "description": "TabHandoff MCP \u2014 handoff.create / status / receipt",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tabhandoff-mcp": "./dist/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/stdio.ts --format esm --dts --clean --external playwright",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@tabhandoff/protocol": "workspace:*",
    "@tabhandoff/runner": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "playwright": "^1.51.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
