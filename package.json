{
  "name": "tabhandoff",
  "version": "0.1.0",
  "private": true,
  "description": "TabHandoff \u2014 the open handoff protocol for AI agents. Your AI was here. Now the next one can pick up.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm test:evidence && pnpm test:bridge",
    "test:evidence": "pnpm --filter @tabhandoff/evidence test",
    "test:bridge": "pnpm --filter @tabhandoff/bridge test",
    "test:agent": "pnpm --filter @tabhandoff/bridge exec node --import tsx --test test/agent-integration.test.ts",
    "desktop": "pnpm --filter @tabhandoff/desktop start",
    "bridge": "pnpm --filter @tabhandoff/bridge start",
    "install:local": "bash scripts/install.sh",
    "tabhandoff": "node packages/cli/dist/index.js",
    "doctor": "node packages/cli/dist/index.js doctor",
    "smoke": "node packages/cli/dist/index.js run --url https://example.com --instruction \"Extract the main heading and first paragraph as markdown\" --wait",
    "demo": "bash scripts/demo.sh",
    "demo:capture": "node scripts/capture-demo.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "test:extension-package": "node scripts/test-extension-package.mjs",
    "website": "node scripts/serve-website.mjs",
    "dist:desktop": "pnpm --filter @tabhandoff/desktop dist",
    "dist:desktop:linux": "pnpm --filter @tabhandoff/desktop dist:linux"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
